# Copy to .env and fill in. The key stays on your machine (server-side).
# Get a Muse Spark key at https://dev.meta.ai/api-keys/
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_NAME=muse-spark-1.1
PORT=5173

# Community (optional)
# COMMUNITY_ADMINS=yourname        usernames that can moderate, comma separated
# COMMUNITY_HIDE_AT=3              reports that hide a novel until it is reviewed
# COMMUNITY_HTTPS=1                set this when the site runs on HTTPS

# SAM 3D Objects (optional; needs Linux + a 32 GB+ NVIDIA GPU). With these set,
# the Start button on the SAM 3D Objects card in 3D Assets runs it on port 8001.
# SAM3D_OBJECTS_REPO=/path/to/sam-3d-objects
# SAM3D_OBJECTS_PYTHON=/path/to/sam-3d-objects/.venv/bin/python
